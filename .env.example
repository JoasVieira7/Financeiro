# ==============================================================================
# FLUXO FINANCEIRO SAAS - VARIÁVEIS DE AMBIENTE (.env.example)
# Renomeie este arquivo para .env no ambiente de desenvolvimento local
# NUNCA insira chaves secretas (service_role) neste arquivo ou no frontend.
# ==============================================================================

# Supabase Auth e Banco de Dados (URL do projeto e chave pública anon)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Web Push Notifications (Chave Pública VAPID para registro do navegador)
# Gerar par de chaves com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid-aqui

# Identificação do Aplicativo (App Store / Google Play / Capacitor)
VITE_APP_NAME=Fluxo Financeiro
VITE_APP_ID=com.financeiroexpress.app
VITE_SUPPORT_EMAIL=suporte@fluxofinanceiro.com.br

# ------------------------------------------------------------------------------
# VARIÁVEIS DE SERVIDOR (CONFIGURAR APENAS NOS SECRETS DO SUPABASE EDGE FUNCTIONS)
# NUNCA expor no frontend (.env)
# ------------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=sua-chave-publica-vapid
# VAPID_PRIVATE_KEY=sua-chave-privada-vapid-secreta
# VAPID_SUBJECT=mailto:suporte@fluxofinanceiro.com.br
